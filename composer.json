{
  "name": "abrbit/laravel-scout-elasticsearch",
  "description": "A Laravel Scout driver for Elasticsearch with developer-friendly syntax.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Abrbit Team",
      "email": "dev@abrbit.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/scout": "^10.0",
    "guzzlehttp/guzzle": "^7.5",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.5|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Abrbit\\Scout\\Engines\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Abrbit\\Scout\\Engines\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Abrbit\\Scout\\Engines\\AbrbitSearchServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
